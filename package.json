    "@fontsource/inter": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "0.454.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "esbuild": "0.24.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19"
  }
